{
  "name": "axt-arcane-bundler",
  "version": "0.5.0",
  "description": "Copy selected AyaExpTech Arcane sources and their dependencies to the clipboard.",
  "license": "MIT",
  "repository": "github:AXT-AyaKoto/axt-arcane-bundler",
  "type": "module",
  "bin": {
    "axt-arcane-bundler": "./bin/axt-arcane-bundler.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*_test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/axt-arcane-bundler.js",
    "start:bun": "bun bin/axt-arcane-bundler.js",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*_test.ts\"",
    "test:bun": "bun test ./src"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.3",
    "semver": "7.8.5",
    "sucrase": "3.35.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}