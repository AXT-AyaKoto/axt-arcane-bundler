{
    "name": "axt-arcane-bundler",
    "version": "0.0.0",
    "description": "Copy selected AyaExpTech Arcane sources and their dependencies to the clipboard.",
    "license": "MIT",
    "repository": "github:AXT-AyaKoto/axt-arcane-bundler",
    "bin": {
        "axt-arcane-bundler": "./dist/cli.js"
    },
    "files": [
        "dist/cli.js",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "scripts": {
        "start": "node --import tsx exec.ts",
        "check": "tsc --noEmit",
        "test": "node --import tsx --test src/*_test.ts",
        "test:bun": "bun test ./src",
        "build": "node scripts/build.mjs",
        "compile": "node scripts/compile-all.mjs",
        "prepack": "npm run build",
        "test:package": "node scripts/smoke-package.mjs",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix"
    },
    "devDependencies": {
        "@inquirer/prompts": "8.7.3",
        "@inquirer/testing": "3.3.14",
        "@types/node": "^22.0.0",
        "@types/semver": "^7.7.0",
        "esbuild": "^0.28.2",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "picocolors": "^1.1.1",
        "semver": "^7.7.0",
        "sucrase": "3.35.1",
        "tsx": "^4.20.0",
        "typescript": "5.8.3"
    },
    "engines": {
        "node": "^22.13.0 || >=24.0.0"
    }
}
